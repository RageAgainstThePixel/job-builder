  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RageAgainstThePixel/job-builder.git"
  },
  "bugs": {
    "url": "https://github.com/RageAgainstThePixel/job-builder/issues"
  },
  "homepage": "https://github.com/RageAgainstThePixel/job-builder",
  "main": "dist/index.js",
  "keywords": [],
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.5.2",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "tests": "jest --runInBand --detectOpenHandles --forceExit",
    "build": "npm run clean && npm run bundle",
